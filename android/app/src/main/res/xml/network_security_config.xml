<?xml version="1.0" encoding="utf-8"?>
<!-- Весь трафик приложения — строго HTTPS. Исключение для незашифрованного
     API-сервера убрано: боевой API живёт на https://autoterra.shop/api/.
     Возвращать сюда IP или домен по http нельзя — Play Console отмечает такие
     сборки как небезопасные, а на iOS аналогичное послабление (ATS) Apple
     требует отдельно обосновывать на ревью. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
