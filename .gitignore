# .env объявлен ассетом в pubspec.yaml, без него `flutter build` падает на
# любом чистом клоне. Секретов в нём нет — только публичный адрес API, он и
# так лежит внутри каждого собранного APK. Всё, что с настоящими секретами
# (.env.local, .env.production), по-прежнему игнорируется.
.env.*
!.env.example
!backend/.env.example
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

